# Supabase — salin ke .env.local dan isi dengan nilai project Anda.
# Yang berawalan NEXT_PUBLIC_ boleh sampai ke browser; sisanya server-only.

NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# JANGAN commit / JANGAN expose ke frontend:
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Opsional (fitur menyusul):
# RESEND_API_KEY="<resend-key>"   # email "Kirim Pengingat"
