# Supabase — salin ke .env.local dan isi dengan nilai project Anda.
# Yang berawalan NEXT_PUBLIC_ boleh sampai ke browser; sisanya server-only.
#
# PENTING (alur dev/staging — lihat DEVELOPMENT.md):
# - Kerja di branch `dev`/feature branch → isi .env.local dengan kredensial project
#   Supabase DEV (project terpisah, BUKAN production). Jangan pernah pakai kredensial
#   production untuk development lokal — data pegawai di production adalah data NYATA.
# - Kredensial production hanya disetel di Vercel Dashboard (scope "Production"), tidak
#   pernah di laptop developer maupun file yang ter-commit.

NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# JANGAN commit / JANGAN expose ke frontend:
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Opsional — dipakai scripts/apply-migration.mjs untuk menerapkan migrasi SQL manual
# (koneksi Postgres langsung; format: postgres://postgres:<password>@<host>:5432/postgres).
# Isi dengan connection string project DEV saat menguji migrasi baru secara lokal.
# SUPABASE_DB_URL="<postgres-connection-string>"

# Opsional (fitur menyusul):
# RESEND_API_KEY="<resend-key>"   # email "Kirim Pengingat"
